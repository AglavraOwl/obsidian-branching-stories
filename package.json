{
  "name": "obsidian-branching-stories",
  "version": "0.1.0",
  "description": "Generate and explore branching stories in Obsidian: one note per turn, linked into a tree.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "install-test": "node scripts/install-test.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  }
}
